<resources>
    <!--=========================================================
         MAIN APP THEME
         =========================================================-->
    <style name="AppTheme" parent="Theme.Material3Expressive.DynamicColors.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowSplashScreenBackground">@color/launcher_icon_background</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="tabStyle">@style/Widget.App.TabLayout</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.SettingsDialog</item>
    </style>
    <!--=========================================================
         TAB TYPOGRAPHY
         =========================================================-->
    <style name="TextAppearance.App.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textFontWeight">400</item>
    </style>
    <style name="TextAppearance.App.Tab.Selected" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="Widget.App.TabLayout" parent="Widget.Material3.TabLayout.Secondary">
        <item name="android:background">@null</item>
    </style>
    <!--=========================================================
         SETTINGS DIALOG OVERLAY
         =========================================================-->
    <style name="ThemeOverlay.App.SettingsDialog" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.App.Settings.Title.Text</item>
    </style>
    <style name="MaterialAlertDialog.App.Settings.Title.Text" parent="MaterialAlertDialog.Material3Expressive.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.App.Settings.DialogTitle</item>
    </style>
    <!--Dialog Title-->
    <style name="TextAppearance.App.Settings.DialogTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <!--Section Title: Uppercase, Semibold, Accent Tint-->
    <style name="TextAppearance.App.Settings.SectionHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <!--Row Item Title-->
    <style name="TextAppearance.App.Settings.RowTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <!--Row Subtitle Text-->
    <style name="TextAppearance.App.Settings.RowSecondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <!--Radio Button Text-->
    <style name="TextAppearance.App.Settings.Radio" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>
